# Contact Form (Incoming inquiries from students sent to site admin)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Outbound Transactional Email Providers for Admin OTP Delivery
# Set either Resend or Brevo for direct delivery to any recipient inbox
RESEND_API_KEY=your_resend_api_key_here
# BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=security@dopilot.online
SUPPORT_EMAIL=support@dopilot.online

GROQ_API_KEY=your_groq_api_key_here

# Cloudinary CDN Configuration (Optional: Can also be configured directly in Admin Panel)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here

# Payment Gateway Configuration (Razorpay)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
